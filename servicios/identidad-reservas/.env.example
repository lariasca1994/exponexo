# =====================================================================================
#  ExpoNexo · Identidad, reservas y agenda (FastAPI · SQL Server) · plantilla de variables
# =====================================================================================
# Uso: copia este archivo a .env en esta misma carpeta y completa los valores reales.
#      El .env NUNCA se sube. En producción estas variables se cargan como secretos
#      (GitHub y Azure Container Apps).
#
# Nombres: <GRUPO>_<DETALLE>_<UNIDAD o TIPO>, en mayúsculas y sin tildes.
#          La unidad o el tipo va siempre al final: _URL, _RUTA, _MINUTOS, _DIAS, _ID.
#
# Etiquetas:
#   [SECRETO]     Nunca en el repositorio ni en capturas. En producción, como secreto.
#   [COMPARTIDA]  Debe tener el mismo valor en los servicios indicados.
#   [DECIDES TÚ]  No hay un valor único correcto: elígelo y anota el porqué en DECISIONES.md.
#   [FIJO]        El nombre lo exige una librería o un SDK: no lo cambies.
# =====================================================================================


# ------------------------------------------------------------------ 1. General
# Entorno en que corre el servicio: desarrollo | produccion
APP_ENTORNO=desarrollo

# Puerto local del servicio (pagos usa el 8002 y mesa de ayuda el 8003)
APP_PUERTO=8001

# Nivel de detalle de los logs: DEBUG | INFO | WARNING | ERROR
APP_NIVEL_LOGS=INFO

# Dirección del portal, para armar los enlaces de los correos
# [COMPARTIDA] pagos, eventos
PORTAL_URL=http://localhost:5173

# Orígenes que pueden llamar a esta API desde el navegador (CORS), separados por coma
# [COMPARTIDA] pagos, mesa de ayuda
CORS_ORIGENES_PERMITIDOS=http://localhost:5173


# ------------------------------------------------------------------ 2. Base de datos · SQL Server (Azure SQL)
# Datos que te da Azure al crear el servidor y la base (ver infra/README.md)
SQLSERVER_SERVIDOR=TU_SERVIDOR.database.windows.net
SQLSERVER_PUERTO=1433
SQLSERVER_BASE=TU_BASE
SQLSERVER_USUARIO=TU_USUARIO

# [SECRETO]
SQLSERVER_CONTRASENA=TU_CONTRASENA

# Nombre exacto del driver ODBC instalado en tu equipo (lo ves en «Orígenes de datos ODBC»)
SQLSERVER_DRIVER_ODBC=ODBC Driver 18 for SQL Server


# ------------------------------------------------------------------ 3. Tokens de acceso (JWT RS256)
# Este servicio EMITE los tokens; pagos y mesa de ayuda solo los validan.

# Quién emite los tokens: la URL pública de este servicio
# [COMPARTIDA] pagos, mesa de ayuda
JWT_EMISOR=http://localhost:8001

# Para quién son los tokens
# [COMPARTIDA] pagos, mesa de ayuda
JWT_AUDIENCIA=exponexo

# Identificador de la clave de firma (el «kid» que aparece en el JWKS). Cámbialo al rotar la clave.
JWT_CLAVE_ID=CLAVE_AAAA_MM

# Ruta del archivo .pem con la clave privada de firma (fuera del repositorio)
# [SECRETO] el archivo al que apunta
JWT_CLAVE_PRIVADA_RUTA=claves/jwt_privada.pem

# Vigencia del token de acceso, en minutos
# [DECIDES TÚ]
JWT_ACCESO_MINUTOS=15

# Vigencia del token de refresco, en días
# [DECIDES TÚ]
JWT_REFRESCO_DIAS=7


# ------------------------------------------------------------------ 4. Verificación en dos pasos (MFA)
# Nombre que verá la persona en su app autenticadora
MFA_EMISOR_NOMBRE=ExpoNexo

# Clave de cifrado de los datos de MFA: 32 bytes aleatorios en base64
# [SECRETO]
MFA_CLAVE_CIFRADO=

# Vigencia del pase entre la contraseña y el código, en minutos
# [DECIDES TÚ]
MFA_PASE_MINUTOS=5

# Vigencia de un código enviado por correo, en minutos
# [DECIDES TÚ]
MFA_CODIGO_CORREO_MINUTOS=10

# Intentos fallidos permitidos antes del bloqueo
# [DECIDES TÚ]
MFA_INTENTOS_MAXIMOS=5

# Duración del bloqueo, en minutos
# [DECIDES TÚ]
MFA_BLOQUEO_MINUTOS=15


# ------------------------------------------------------------------ 5. Llaves de acceso (WebAuthn)
# Dominio del portal, sin protocolo ni puerto (en tu equipo: localhost)
WEBAUTHN_RP_ID=localhost

# Nombre que muestra el navegador al registrar la llave
WEBAUTHN_RP_NOMBRE=ExpoNexo

# Origen exacto del portal, con protocolo y puerto
WEBAUTHN_ORIGEN_URL=http://localhost:5173


# ------------------------------------------------------------------ 6. Correo (Brevo)
# API key de Brevo: Brevo > SMTP & API > API Keys
# [SECRETO] [COMPARTIDA] eventos
BREVO_API_KEY=

# Remitente verificado en Brevo
# [COMPARTIDA] eventos
BREVO_REMITENTE_CORREO=
BREVO_REMITENTE_NOMBRE=ExpoNexo


# ------------------------------------------------------------------ 6.1 Imagenes (Cloudinary)
# [SECRETO]
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ------------------------------------------------------------------ 7. Cola de eventos (AWS SQS)
# Región donde creaste la cola
# [FIJO] [COMPARTIDA] pagos, mesa de ayuda, eventos
AWS_REGION=

# ARN del tema SNS de eventos (aws sns list-topics); reparte cada evento a las colas de las funciones
# [COMPARTIDA] pagos, mesa de ayuda, eventos
SNS_TEMA_EVENTOS_ARN=

# Usuario de AWS con permiso SOLO para publicar en el tema (sns:Publish). También en producción,
# porque estos servicios corren fuera de AWS (Azure y Cloud Run) y no pueden asumir roles por OIDC.
# [FIJO] [SECRETO]
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# ------------------------------------------------------------------ 8. Rutas internas
# Las llama el repartidor de eventos. El mecanismo lo decides en ADR-016 (DECISIONES.md).
# [SECRETO] [COMPARTIDA] pagos, mesa de ayuda, eventos
INTERNO_SECRETO=


# ------------------------------------------------------------------ 9. Reglas de negocio
# Tiempo que tiene un expositor para pagar una reserva, en minutos
# [DECIDES TÚ]
RESERVA_VENCIMIENTO_MINUTOS=30

# Clave para firmar los QR de las entradas: 32 bytes aleatorios en base64
# [SECRETO]
ENTRADA_QR_CLAVE_FIRMA=


# ------------------------------------------------------------------ 10. Cuentas fijas
# Lista JSON de las cuentas de administración, personal y QA: el servicio las crea o ajusta al
# arrancar (correo verificado y verificación en dos pasos por correo). Son las únicas con rol
# personal o administrador: el registro público solo crea visitantes o expositores.
# Formato: [{"correo": "...", "nombre": "...", "rol": "administrador", "contrasena": "..."}]
# [SECRETO]
USUARIOS_INICIALES=
