# =====================================================================================
#  ExpoNexo · Pagos y facturación (Spring Boot · Oracle) · plantilla de variables
# =====================================================================================
# Uso: copia este archivo a .env en esta misma carpeta y completa los valores reales.
#      El .env NUNCA se sube. En producción estas variables se cargan como secretos
#      (GitHub y Cloud Run).
#
# Nombres: <GRUPO>_<DETALLE>_<UNIDAD o TIPO>, en mayúsculas y sin tildes.
#          La unidad o el tipo va siempre al final: _URL, _RUTA, _MINUTOS, _PORCENTAJE.
#
# Etiquetas:
#   [SECRETO]     Nunca en el repositorio ni en capturas. En producción, como secreto.
#   [COMPARTIDA]  Debe tener el mismo valor en los servicios indicados.
#   [DECIDES TÚ]  No hay un valor único correcto: elígelo y anota el porqué en DECISIONES.md.
#   [FIJO]        El nombre lo exige Spring Boot o un SDK: no lo cambies.
# =====================================================================================


# ------------------------------------------------------------------ 1. General
# Perfil de Spring (equivale a APP_ENTORNO en los demás servicios): desarrollo | produccion
# [FIJO]
SPRING_PROFILES_ACTIVE=desarrollo

# Puerto local del servicio (identidad usa el 8001 y mesa de ayuda el 8003)
# [FIJO]
SERVER_PORT=8002

# Dirección del portal, para armar los enlaces de los comprobantes
# [COMPARTIDA] identidad-reservas, eventos
PORTAL_URL=http://localhost:5173

# Orígenes que pueden llamar a esta API desde el navegador (CORS), separados por coma
# [COMPARTIDA] identidad-reservas, mesa de ayuda
CORS_ORIGENES_PERMITIDOS=http://localhost:5173


# ------------------------------------------------------------------ 2. Base de datos · Oracle Autonomous (con wallet)
# Alias de conexión del archivo tnsnames.ora del wallet (por ejemplo, el que termina en _tp)
ORACLE_TNS_ALIAS=TU_BASE_tp
ORACLE_USUARIO=TU_USUARIO

# [SECRETO]
ORACLE_CONTRASENA=TU_CONTRASENA

# Carpeta donde descomprimiste el wallet (fuera del repositorio o en wallet/, que está excluida)
# [SECRETO] la carpeta a la que apunta
ORACLE_WALLET_RUTA=RUTA_A_TU_WALLET


# ------------------------------------------------------------------ 3. Validación de tokens (los emite identidad-reservas)
# [COMPARTIDA] identidad-reservas, mesa de ayuda
JWT_EMISOR=http://localhost:8001

# [COMPARTIDA] identidad-reservas, mesa de ayuda
JWT_AUDIENCIA=exponexo

# Dónde publica identidad-reservas sus claves públicas
# [COMPARTIDA] mesa de ayuda
JWT_JWKS_URL=http://localhost:8001/.well-known/jwks.json


# ------------------------------------------------------------------ 4. Llamadas a identidad-reservas
# Dirección del servicio de identidad y reservas (para sus rutas internas)
# [COMPARTIDA] eventos
IDENTIDAD_URL=http://localhost:8001

# [SECRETO] [COMPARTIDA] identidad-reservas, mesa de ayuda, eventos
INTERNO_SECRETO=


# ------------------------------------------------------------------ 5. Cobro con QR
# Clave para firmar el contenido de los QR de cobro: 32 bytes aleatorios en base64
# [SECRETO]
COBRO_QR_CLAVE_FIRMA=

# Vigencia de un QR de cobro, en minutos
# [DECIDES TÚ]
COBRO_QR_VIGENCIA_MINUTOS=


# ------------------------------------------------------------------ 6. Facturación
# Prefijo del número consecutivo de las facturas
FACTURA_PREFIJO=EXN

# Moneda de las facturas (código ISO 4217)
FACTURA_MONEDA=COP

# Porcentaje de impuesto que aplica la factura
# [DECIDES TÚ]
FACTURA_IMPUESTO_PORCENTAJE=


# ------------------------------------------------------------------ 7. Cola de eventos (AWS SQS)
# [FIJO] [COMPARTIDA] identidad-reservas, mesa de ayuda, eventos
AWS_REGION=

# [COMPARTIDA] identidad-reservas, mesa de ayuda, eventos
SNS_TEMA_EVENTOS_ARN=

# Usuario de AWS con permiso SOLO para publicar en el tema (sns:Publish). También en producción,
# porque estos servicios corren fuera de AWS (Azure y Cloud Run) y no pueden asumir roles por OIDC.
# [FIJO] [SECRETO]
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
