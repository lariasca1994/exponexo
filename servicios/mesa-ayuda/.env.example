# =====================================================================================
#  ExpoNexo · Mesa de ayuda y monitoreo (ASP.NET Core · MongoDB) · plantilla de variables
# =====================================================================================
# Uso: copia este archivo a .env en esta misma carpeta (o guarda los valores con
#      dotnet user-secrets) y completa los valores reales. El .env NUNCA se sube.
#      En producción se cargan como secretos de la Container App.
#
# Nombres: <GRUPO>_<DETALLE>_<UNIDAD o TIPO>, en mayúsculas y sin tildes, iguales a los
#          de los demás servicios. La unidad o el tipo va siempre al final: _URL, _MINUTOS, _DIAS.
#
# Etiquetas:
#   [SECRETO]     Nunca en el repositorio ni en capturas. En producción, como secreto.
#   [COMPARTIDA]  Debe tener el mismo valor en los servicios indicados.
#   [DECIDES TÚ]  No hay un valor único correcto: elígelo y anota el porqué en DECISIONES.md.
#   [FIJO]        El nombre lo exige ASP.NET Core o un SDK: no lo cambies.
# =====================================================================================


# ------------------------------------------------------------------ 1. General
# Entorno de ASP.NET Core (equivale a APP_ENTORNO en los demás servicios): Development | Production
# [FIJO]
ASPNETCORE_ENVIRONMENT=Development

# Dirección y puerto local del servicio (identidad usa el 8001 y pagos el 8002)
# [FIJO]
ASPNETCORE_URLS=http://localhost:8003

# Orígenes que pueden llamar a esta API desde el navegador (CORS), separados por coma
# [COMPARTIDA] identidad-reservas, pagos
CORS_ORIGENES_PERMITIDOS=http://localhost:5173


# ------------------------------------------------------------------ 2. Base de datos · MongoDB Atlas
# Cadena de conexión que te da Atlas (Connect > Drivers), con usuario y contraseña de la base
# [SECRETO]
MONGO_URI=mongodb+srv://TU_USUARIO:TU_CONTRASENA@TU_CLUSTER.mongodb.net

# Nombre de la base de este servicio
MONGO_BASE=exponexo_mesa


# ------------------------------------------------------------------ 3. Validación de tokens (los emite identidad-reservas)
# [COMPARTIDA] identidad-reservas, pagos
JWT_EMISOR=http://localhost:8001

# [COMPARTIDA] identidad-reservas, pagos
JWT_AUDIENCIA=exponexo

# Dónde publica identidad-reservas sus claves públicas
# [COMPARTIDA] pagos
JWT_JWKS_URL=http://localhost:8001/.well-known/jwks.json


# ------------------------------------------------------------------ 4. Dispositivos del recinto (kioscos y pantallas)
# Código con el que un kiosco nuevo se registra: genera uno aleatorio
# [SECRETO]
DISPOSITIVO_CODIGO_ENROLAMIENTO=

# Tiempo sin reporte para considerar caído un dispositivo, en minutos
# [DECIDES TÚ]
DISPOSITIVO_SIN_REPORTE_MINUTOS=

# Tiempo que se guardan las lecturas antes de borrarse solas, en días
# [DECIDES TÚ]
LECTURA_RETENCION_DIAS=


# ------------------------------------------------------------------ 5. Rutas internas
# Las llama el repartidor de eventos. El mecanismo lo decides en ADR-016 (DECISIONES.md).
# [SECRETO] [COMPARTIDA] identidad-reservas, pagos, eventos
INTERNO_SECRETO=


# ------------------------------------------------------------------ 6. Cola de eventos (AWS SQS)
# [FIJO] [COMPARTIDA] identidad-reservas, pagos, eventos
AWS_REGION=

# [COMPARTIDA] identidad-reservas, pagos, eventos
SQS_COLA_EVENTOS_URL=

# Únicamente en tu equipo: en producción NO se usan (el despliegue usa OIDC y roles).
# [FIJO] [SECRETO]
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
