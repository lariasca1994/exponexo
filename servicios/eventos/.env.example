# =====================================================================================
#  ExpoNexo · Eventos entre servicios (SQS · Lambda en Python) · plantilla de variables
# =====================================================================================
# Uso: copia este archivo a .env en esta misma carpeta para las pruebas locales.
#      El .env NUNCA se sube. En producción estas variables se configuran en cada
#      función Lambda (desde el workflow).
#
# Nombres: <GRUPO>_<DETALLE>_<UNIDAD o TIPO>, en mayúsculas y sin tildes.
#          La unidad o el tipo va siempre al final: _URL, _TOKEN, _ID.
#
# Etiquetas:
#   [SECRETO]     Nunca en el repositorio ni en capturas. En producción, como secreto.
#   [COMPARTIDA]  Debe tener el mismo valor en los servicios indicados.
#   [DECIDES TÚ]  No hay un valor único correcto: elígelo y anota el porqué en DECISIONES.md.
#   [FIJO]        El nombre lo exige un SDK: no lo cambies.
# =====================================================================================


# ------------------------------------------------------------------ 1. Colas (AWS SQS)
# [FIJO] [COMPARTIDA] identidad-reservas, pagos, mesa de ayuda
AWS_REGION=

# Las funciones reciben los eventos por sus colas SQS (activador de Lambda): no necesitan URL
# de cola ni credenciales propias; usan su rol de ejecución.


# ------------------------------------------------------------------ 2. Servicios a los que llama el repartidor (rutas internas)
# [COMPARTIDA] pagos
IDENTIDAD_URL=http://localhost:8001
PAGOS_URL=http://localhost:8002
MESA_AYUDA_URL=http://localhost:8003

# [SECRETO] [COMPARTIDA] identidad-reservas, pagos, mesa de ayuda
INTERNO_SECRETO=


# ------------------------------------------------------------------ 3. Correo (Brevo)
# API key de Brevo: Brevo > SMTP & API > API Keys
# [SECRETO] [COMPARTIDA] identidad-reservas
BREVO_API_KEY=

# Remitente verificado en Brevo
# [COMPARTIDA] identidad-reservas
BREVO_REMITENTE_CORREO=
BREVO_REMITENTE_NOMBRE=ExpoNexo


# ------------------------------------------------------------------ 4. Telegram (avisos al personal del recinto)
# Token que te da @BotFather al crear el bot
# [SECRETO]
TELEGRAM_BOT_TOKEN=

# Chat o grupo del personal (investiga «get Telegram chat id»)
TELEGRAM_CHAT_ID=


# ------------------------------------------------------------------ 5. Enlaces en los mensajes
# [COMPARTIDA] identidad-reservas, pagos
PORTAL_URL=http://localhost:5173
