# =====================================================================================
#  ExpoNexo · Portal (React · Vite) · plantilla de variables
# =====================================================================================
# Uso: copia este archivo a .env en esta misma carpeta.
#      En producción se configuran en Vercel (Project Settings > Environment Variables).
#
# ATENCIÓN: toda variable VITE_ queda visible para cualquiera en el navegador.
#           Aquí solo van direcciones y textos públicos, NUNCA secretos ni claves.
#
# Nombres: VITE_<GRUPO>_<DETALLE>_<TIPO>, en mayúsculas y sin tildes. El prefijo VITE_ es
#          [FIJO]: sin él, Vite no expone la variable al código del portal.
# =====================================================================================


# ------------------------------------------------------------------ 1. Direcciones de los servicios
VITE_IDENTIDAD_URL=http://localhost:8001
VITE_PAGOS_URL=http://localhost:8002
VITE_MESA_AYUDA_URL=http://localhost:8003


# ------------------------------------------------------------------ 2. General
# Entorno que se muestra en la pantalla: desarrollo | produccion
VITE_APP_ENTORNO=desarrollo
